{
 "id": "sort",
 "title": "The Sorter",
 "blurb": "Thirteen places hold items, and each takes different things: the house chests, Carl's stock and chest, the Kuku Pot, a horse's slot, a wagon, a ship's hold and an island store. One sheet says where each kind of item belongs; the other says which of them crafting, cooking, trade and the camp can read without you carrying it. Search any item to see where it goes.",
 "marks": [
  {
   "id": "home",
   "label": "Home",
   "text": "Built for it, and the mechanic that uses it reads it here."
  },
  {
   "id": "draw",
   "label": "Read here",
   "text": "The mechanic takes it from here without you carrying it."
  },
  {
   "id": "ok",
   "label": "Fits",
   "text": "Kept safe here; take it out to use it."
  },
  {
   "id": "give",
   "label": "Donate",
   "text": "One-way into the camp's stock, which missions and builds spend."
  },
  {
   "id": "recv",
   "label": "Arrives",
   "text": "You can't put it in; missed loot and rewards land here."
  },
  {
   "id": "unk",
   "label": "Reported",
   "text": "One source says so; no patch note or second source confirms it."
  },
  {
   "id": "no",
   "label": "Refused",
   "text": "A source says it won't go in, or won't be read."
  }
 ],
